NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Supermercado MM
APP_BASE_URL=https://mercadomm.com.br

# ============================================================
# BANCO DE DADOS - MySQL (Hostinger hPanel)
# ============================================================
# Hostinger: mysql://u193425377_root:SENHA@localhost:3306/u193425377_mercadomm
# Local dev: mysql://mm:mm@localhost:3306/mm
# Nota: caracteres especiais na senha devem ser URL-encoded
#   : → %3A   ? → %3F   $ → %24   @ → %40   # → %23
DATABASE_URL="mysql://mm:mm@localhost:3306/mm"

# ============================================================
# FILA / CACHE - Redis (Upstash)
# ============================================================
# Upstash free tier: 500K comandos/mês, 256 MB
# URL formato: rediss://default:TOKEN@HOST.upstash.io:6379
# Local dev: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ============================================================
# WHATSAPP CLOUD API (Meta)
# ============================================================
# Webhook URL produção: https://mercadomm.com.br/api/webhooks/whatsapp
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SYSTEM_USER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PATH=/api/webhooks/whatsapp
WHATSAPP_TEMPLATE_NAMESPACE=
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# ============================================================
# OPENAI - LLM para parsing de pedidos
# ============================================================
# Modelo: gpt-5.4-mini (~$3/mês para 1.400 pedidos)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_TEXT=gpt-5.4-mini
OPENAI_MODEL_AUDIO=gpt-realtime-mini
OPENAI_TIMEOUT_MS=30000

# ============================================================
# ORDER DRAFT - Agregação de mensagens WhatsApp
# ============================================================
ORDER_DRAFT_AGGREGATION_GAP_MS=180000
ORDER_DRAFT_POST_COMMIT_AMENDMENT_WINDOW_MS=600000
ORDER_DRAFT_ASK_REPLY_WINDOW_MS=300000
ORDER_DRAFT_AUTO_CREATE_ORDER_ON_TIMEOUT=true
ORDER_DRAFT_TIMEOUT_CREATE_REQUIRES_ADDRESS_OR_PAYMENT=false

# ============================================================
# LOGS
# ============================================================
LOG_LEVEL=info
CONSOLE_SILENT_EVENT_PREFIXES=whatsapp_
